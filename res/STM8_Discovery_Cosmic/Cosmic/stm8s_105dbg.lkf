Debug\stm8_stl_cpustart_csmc.o
Debug\stm8_stl_fullram_csmc.o
Debug\main.o
Debug\stm8s_it.o
#<END OBJECT_FILES>


# Library list - section reserved for STVD
#<BEGIN LIBRARY_FILES>
libis0.sm8
libm0.sm8
#<END LIBRARY_FILES>


# Interrupt vectors file - section reserved for STVD
#<BEGIN VECTOR_FILE>
+seg .const -b 0x8000 -k -ck
Debug\stm8_interrupt_vector.o
#<END VECTOR_FILE>

# Defines - section reserved for STVD
#<BEGIN DEFINED_VARIABLES>
+def __endzp=@.ubsct			# end of uninitialized zpage
+def __memory=@.bss				# end of bss segment
+def __startmem=@.bss
+def __endmem=0x5ff
+def __stack=0x7ff
+def __clb_start=0x0f			# begin of area dedciated for class B variables - !!! TO BE DEFINED BY USER !!!
+def __clb_end=0x7e				# end of area dedciated for class B variables - !!! TO BE DEFINED BY USER !!!
#<END DEFINED_VARIABLES>
