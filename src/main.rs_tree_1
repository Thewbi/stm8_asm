use std::cell::RefCell;
use std::rc::Rc;
use std::rc::Weak;

// Übersicht mit KI               To construct a Weak<RefCell<T>>, you first create a strong Rc<RefCell<T>> to hold the data, and then downgrade it. A Weak pointer does not own the data, meaning it won't prevent the Rc from being dropped, which is highly useful for breaking cyclic references (e.g., in parent-child relationships).Here is how you define and construct it:

