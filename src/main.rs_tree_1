// https://users.rust-lang.org/t/need-help-creating-a-tree-node-struct/79866
struct Node {
    value: String,
    parent: Option<Weak<RefCell<Node>>>,
    left: Option<Weak<RefCell<Node>>>,
    right: Option<Weak<RefCell<Node>>>,
    //children: Vec<Rc<RefCell<Node>>>,
}

fn postfix_to_infix(node: &mut Node, character: char) {

    let mut child = Node{     
        value: String::from(character.to_string()),
        parent: None,
        left: None,
        right: None,
        //children: !vec[],
    };

    let strong_ref: Rc<RefCell<Node>> = Rc::new(RefCell::new(child));
    let weak_ref: Weak<RefCell<Node>> = Rc::downgrade(&strong_ref);

    node.left = Some(weak_ref);
}


fn main() {

    let mut root = Node{     
        value: String::from("root"),
        parent: None,
        left: None,
        right: None,
        //children: !vec[],
    };

    postfix_to_infix(&mut root, 'c');

    println!("test {:?}", root.left.unwrap());

}