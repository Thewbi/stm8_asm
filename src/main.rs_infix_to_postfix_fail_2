#[derive(Debug, Clone, Eq, PartialEq, Copy)]
enum RegexBuildingBlock {

    CharacterLiteral(char, u8),

    Concatenation,

    CharacterClass(char, char, u8),

    Repeat(u8, u8, u8),

    Or,

    OpeningBraces,
    CloseingBraces,

}

fn postfix_to_infix(regex_infix: &str, regex_postfix: &mut Vec<RegexBuildingBlock>) {

    let mut stack: Vec<RegexBuildingBlock> = vec![];

    let mut character_class_mode: bool = false; // for [a-z]
    let mut repeat_mode: bool = false; // for {2}, {3,4}

    let mut character_start_option: Option<char> = None;
    let mut character_end_option: Option<char> = None;

    let mut concat: bool = false;
    let mut last_push_was_character_literal = false;

    let mut removed_empty_brackets: bool = false;

    let mut stack_level: u8 = 0;
    let mut blocked: bool = false;

    let mut chars = regex_infix.chars().fuse();
    while let Some(c) = chars.next() {

        println!("");
        println!("{}", c);
        println!("Stacklevel: {}", stack_level);
        println!("Stack:   {:?}", stack);
        println!("Postfix: {:?}", regex_postfix);

        // determine system state
        let mut is_stack_empty = stack.len() == 0;
        let mut is_postfix_empty = regex_postfix.len() == 0;
        let mut is_postfix_has_same_stack_level_literal = false;
        if !is_postfix_empty {

            // match regex_postfix.last().unwrap() {
            //     RegexBuildingBlock::CharacterLiteral(_, enum_stack_level) => { is_postfix_has_same_stack_level_literal = *enum_stack_level == stack_level; }
            //     RegexBuildingBlock::CharacterClass(_, _, enum_stack_level) => { is_postfix_has_same_stack_level_literal = *enum_stack_level == stack_level; }
            //     RegexBuildingBlock::Repeat(_, _, enum_stack_level) => { is_postfix_has_same_stack_level_literal = *enum_stack_level == stack_level; }
            //     _ => {}
            // }

            for object in regex_postfix.iter().rev() {
                match object {
                    RegexBuildingBlock::CharacterLiteral(_, enum_stack_level) => { is_postfix_has_same_stack_level_literal = *enum_stack_level == stack_level; break; }
                    RegexBuildingBlock::CharacterClass(_, _, enum_stack_level) => { is_postfix_has_same_stack_level_literal = *enum_stack_level == stack_level; break; }
                    RegexBuildingBlock::Repeat(_, _, enum_stack_level) => { is_postfix_has_same_stack_level_literal = *enum_stack_level == stack_level; break; }
                    _ => {}
                }
            }
        }
        let mut is_postfix_has_concatenation = false;
        if !is_postfix_empty {
            match regex_postfix.last().unwrap() {
                RegexBuildingBlock::Concatenation => { is_postfix_has_concatenation = true }
                _ => {}
            }
        }

        match c {

            '!' => { panic!(); }

            // # not allowed in regex format
            '#' => { panic!(); }

            '+' | '*' => {

                let mut min:u8 = 0;
                if c == '+' {
                    min = 1;
                }

                // in the regex look for an element on the same stack level
                let mut found: bool = false;
                for object in regex_postfix.iter().rev() {
                    match object {
                        RegexBuildingBlock::CharacterLiteral(_, enum_stack_level) => { if *enum_stack_level == stack_level { found = true; break; } }
                        RegexBuildingBlock::CharacterClass(_, _, enum_stack_level) => { if *enum_stack_level == stack_level { found = true; break; } }
                        RegexBuildingBlock::Repeat(_, _, enum_stack_level) => { if *enum_stack_level == stack_level { found = true; break; } }
                        _ => {}
                    }
                }

                // regex_postfix.push(RegexBuildingBlock::Repeat(min, std::u8::MAX, stack_level));

                // if found && blocked {
                //     regex_postfix.push(RegexBuildingBlock::Concatenation);
                // }

                // RULE 5
                if is_postfix_has_concatenation && !blocked {
                    regex_postfix.pop();
                    regex_postfix.push(RegexBuildingBlock::Repeat(min, std::u8::MAX, stack_level));
                    regex_postfix.push(RegexBuildingBlock::Concatenation);
                } else if blocked {
                    regex_postfix.push(RegexBuildingBlock::Repeat(min, std::u8::MAX, stack_level));
                } else {
                    regex_postfix.push(RegexBuildingBlock::Repeat(min, std::u8::MAX, stack_level));
                }

                if found {
                    regex_postfix.push(RegexBuildingBlock::Concatenation);
                }

                // // RULE 5
                // if is_postfix_has_concatenation && !blocked {
                //     regex_postfix.pop();
                //     regex_postfix.push(RegexBuildingBlock::Repeat(min, std::u8::MAX, stack_level));
                //     regex_postfix.push(RegexBuildingBlock::Concatenation);
                // } else if blocked {
                //     regex_postfix.push(RegexBuildingBlock::Repeat(min, std::u8::MAX, stack_level));
                //     regex_postfix.push(RegexBuildingBlock::Concatenation);
                // } else {
                //     regex_postfix.push(RegexBuildingBlock::Repeat(min, std::u8::MAX, stack_level));
                // }
            }

            '(' => {
                // RULE 2
                stack.push(RegexBuildingBlock::OpeningBraces);
                stack_level = stack_level + 1;

                blocked = false;
            }

            ')' => {
                // RULE 3
                //stack.push(RegexBuildingBlock::CloseingBraces);

                while let Some(block) = stack.pop() {
                    match block {
                        RegexBuildingBlock::OpeningBraces => { break; }
                        _ => {}
                    }
                }

                // // does not work with (a)
                // if stack.len() == 0 {
                //     regex_postfix.push(RegexBuildingBlock::Concatenation);
                // }

                blocked = true;

                stack_level = stack_level - 1;
            }

            //
            // Bypass and Repeat
            //

            '?' => {
                let mut repeat = RegexBuildingBlock::Repeat(
                    0 as u8, 
                    1 as u8,
                    stack_level
                );

                // RULE 5
                if is_postfix_has_concatenation && !blocked {
                    regex_postfix.pop();
                    regex_postfix.push(repeat);
                    regex_postfix.push(RegexBuildingBlock::Concatenation);
                } else {
                    regex_postfix.push(repeat);
                }

                character_start_option = None;
                character_end_option = None;
            }

            '{' => {
                if character_class_mode || repeat_mode {
                    panic!("Illegal Syntax! Nested brackets!");
                }
                repeat_mode = true;

                // move from stack to postfix
                while let Some(block) = stack.pop() {
                    regex_postfix.push(block);
                }
            }

            '}' => {
                if !repeat_mode {
                    panic!("Illegal Syntax! '}}' used without opening brackets!");
                }
                repeat_mode = false;

                if character_end_option == None {
                    character_end_option = character_start_option;
                }

                let mut repeat = RegexBuildingBlock::Repeat(
                    (character_start_option.unwrap() as u8 - 0x30) as u8, 
                    (character_end_option.unwrap() as u8 - 0x30) as u8,
                    stack_level
                );

                // RULE 5
                if is_postfix_has_concatenation && !blocked {
                    regex_postfix.pop();
                    regex_postfix.push(repeat);
                    regex_postfix.push(RegexBuildingBlock::Concatenation);
                } else {
                    regex_postfix.push(repeat);
                }

                character_start_option = None;
                character_end_option = None;
            }

            //
            // Character Class
            //

            '[' => { 
                if character_class_mode || repeat_mode {
                    panic!("Illegal Syntax! Nested brackets!");
                }
                character_class_mode = true;
                // move from stack to postfix
                if regex_postfix.len() > 0 { concat = true; }
                while let Some(block) = stack.pop() {
                    regex_postfix.push(block);
                    if concat {
                        regex_postfix.push(RegexBuildingBlock::Concatenation);
                        concat = false;
                    }
                }
             }
            ']' => { 
                if !character_class_mode {
                    panic!("Illegal Syntax! ']' used without opening brackets!");
                }
                
                // RULE 1
                regex_postfix.push(RegexBuildingBlock::CharacterClass(character_start_option.unwrap(), character_end_option.unwrap(), stack_level));
                // if is_stack_empty && !is_postfix_empty || is_postfix_has_same_stack_level_literal {
                //     regex_postfix.push(RegexBuildingBlock::Concatenation);
                // }
                // if is_stack_empty {
                //     if is_postfix_has_concatenation || is_postfix_has_same_stack_level_literal {
                //         regex_postfix.push(RegexBuildingBlock::Concatenation);
                //     }
                // }
                if is_stack_empty {
                    if is_postfix_has_concatenation || is_postfix_has_same_stack_level_literal {
                        regex_postfix.push(RegexBuildingBlock::Concatenation);
                    }
                } else {
                    if is_postfix_has_same_stack_level_literal {
                        regex_postfix.push(RegexBuildingBlock::Concatenation);
                    }
                }

                character_start_option = None;
                character_end_option = None;
                character_class_mode = false;
            }

            '-' => {}

            '|' => {
                // RULE 4
                stack.push(RegexBuildingBlock::Or);
                stack_level = stack_level + 1;
            }

            _ => {
                // if in bracket_mode build up the character class operator with start and end node
                if character_class_mode { // e.g. [a-z]
                    if !c.is_alphanumeric() {
                        panic!("Range border in repeat operator is not a numeric character!");
                    }
                    if character_start_option.is_none() {
                        character_start_option = Some(c);
                    } else {
                        character_end_option = Some(c);
                    }
                } else if repeat_mode { // e.g {3}, {2,4}
                    if !c.is_numeric() && c != ',' {
                        panic!("Range border in repeat operator is not a numeric character!");
                    }
                    if character_start_option.is_none() {
                        character_start_option = Some(c);
                        character_end_option = Some(c);
                    } else {
                        character_end_option = Some(c);
                    }
                } else {
                    // RULE 1
                    regex_postfix.push(RegexBuildingBlock::CharacterLiteral(c, stack_level));

                    // if is_stack_empty && !is_postfix_empty || is_postfix_has_same_stack_level_literal {
                    //     regex_postfix.push(RegexBuildingBlock::Concatenation);
                    // }

                    // if is_stack_empty {
                    //     if is_postfix_has_concatenation || is_postfix_has_same_stack_level_literal {
                    //         regex_postfix.push(RegexBuildingBlock::Concatenation);
                    //     }
                    // }

                    if is_stack_empty {
                        if is_postfix_has_concatenation || is_postfix_has_same_stack_level_literal {
                            regex_postfix.push(RegexBuildingBlock::Concatenation);
                        }
                    } else {
                        if is_postfix_has_same_stack_level_literal {
                            regex_postfix.push(RegexBuildingBlock::Concatenation);
                        }
                    }
                }
            }
        }
    } // while

    //
    // end of input (EOI) detected
    //

    println!("End of Input (EOI) detected");
    println!("Stack:   {:?}", stack);
    println!("Postfix: {:?}", regex_postfix);

    if stack.len() > 0 {

        let mut reverter: Vec<RegexBuildingBlock> = vec![];

        // move from stack to postfix
        if regex_postfix.len() > 0 { concat = true; }
        while let Some(block) = stack.pop() {

            match block {

                // the or operator erases # because of the testcase a|b
                RegexBuildingBlock::Or => {

                    while let Some(block) = reverter.pop() {
                        regex_postfix.push(block);
                    }

                    regex_postfix.push(block);

                    stack_level = stack_level - 1;
                }

                _ => { reverter.push(block); }
            }
        }

        while let Some(block) = reverter.pop() {
            regex_postfix.push(block);
            if concat {
                regex_postfix.push(RegexBuildingBlock::Concatenation);
                concat = false;
            }
        }

    }

    println!("Final Postfix: {:?}", regex_postfix);

} // postfix_to_infix

