#[cfg(test)]
mod tests {
    // Note this useful idiom: importing names from outer (for mod tests) scope.
    use super::*;

    #[test]
    fn regex_1_test() {
        let mut regex_postfix: Vec<RegexBuildingBlock> = vec![];
        postfix_to_infix("abcde", &mut regex_postfix);

        assert_eq!(9, regex_postfix.len());
        assert_eq!(regex_postfix[0], RegexBuildingBlock::CharacterLiteral('a', 0));
        assert_eq!(regex_postfix[1], RegexBuildingBlock::CharacterLiteral('b', 0));
        assert_eq!(regex_postfix[2], RegexBuildingBlock::Concatenation);
        assert_eq!(regex_postfix[3], RegexBuildingBlock::CharacterLiteral('c', 0));
        assert_eq!(regex_postfix[4], RegexBuildingBlock::Concatenation);
        assert_eq!(regex_postfix[5], RegexBuildingBlock::CharacterLiteral('d', 0));
        assert_eq!(regex_postfix[6], RegexBuildingBlock::Concatenation);
        assert_eq!(regex_postfix[7], RegexBuildingBlock::CharacterLiteral('e', 0));
        assert_eq!(regex_postfix[8], RegexBuildingBlock::Concatenation);
    }

    #[test]
    fn regex_2_test() {
        let mut regex_postfix: Vec<RegexBuildingBlock> = vec![];
        postfix_to_infix("a+", &mut regex_postfix);

        assert_eq!(2, regex_postfix.len());
        assert_eq!(regex_postfix[0], RegexBuildingBlock::CharacterLiteral('a', 0));
        assert_eq!(regex_postfix[1], RegexBuildingBlock::Repeat(1, std::u8::MAX, 0));
    }

