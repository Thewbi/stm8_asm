#[derive(Debug, Clone, Eq, PartialEq, Copy)]
enum RegexBuildingBlock {

    CharacterLiteral(char),

    Concatenation,

    CharacterClass(char, char),

    Repeat(u8, u8),

    Or,

    OpeningBraces,
    CloseingBraces,

}

fn postfix_to_infix(regex_infix: &str, regex_postfix: &mut Vec<RegexBuildingBlock>) {

    let mut stack: Vec<RegexBuildingBlock> = vec![];

    let mut character_class_mode: bool = false; // for [a-z]
    let mut repeat_mode: bool = false; // for {2}, {3,4}

    let mut character_start_option: Option<char> = None;
    let mut character_end_option: Option<char> = None;

    let mut concat: bool = false;
    let mut last_push_was_character_literal = false;

    let mut removed_empty_brackets: bool = false;

    let mut chars = regex_infix.chars().fuse();
    while let Some(c) = chars.next() {

        println!("{}", c);
        println!("Stack:   {:?}", stack);
        println!("Postfix: {:?}", regex_postfix);

        match c {

            '*' => {
                if regex_postfix.len() > 0 && !last_push_was_character_literal { concat = true; }
                while let Some(block) = stack.pop() {
                    regex_postfix.push(block);
                }

                // remove concatenations
                loop {
                    match regex_postfix.last().unwrap() {
                        RegexBuildingBlock::Concatenation => {
                            regex_postfix.pop();
                            concat = true;
                        }
                        _ => { break; }
                    }
                }

                regex_postfix.push(RegexBuildingBlock::Repeat(0, std::u8::MAX));
                if concat {
                    regex_postfix.push(RegexBuildingBlock::Concatenation);
                    concat = false;
                }
            }

            '+' => {

                if stack.len() == 0 {

                    if removed_empty_brackets {
                        regex_postfix.push(RegexBuildingBlock::Repeat(1, std::u8::MAX));
                        removed_empty_brackets = false;
                    } else {
                    
                        // remove a single concatenation
                        loop {
                            match regex_postfix.last().unwrap() {
                                RegexBuildingBlock::Concatenation => {
                                    regex_postfix.pop();
                                    concat = true;
                                    break;
                                }
                                _ => { break; }
                            }
                        }

                        regex_postfix.push(RegexBuildingBlock::Repeat(1, std::u8::MAX));

                        if concat {
                            regex_postfix.push(RegexBuildingBlock::Concatenation);
                            concat = false;
                        }
                    }
                } else {
                    // remove a single concatenation
                    loop {
                        match regex_postfix.last().unwrap() {
                            RegexBuildingBlock::Concatenation => {
                                regex_postfix.pop();
                                concat = true;
                                break;
                            }
                            _ => { break; }
                        }
                    }

                    regex_postfix.push(RegexBuildingBlock::Repeat(1, std::u8::MAX));

                    if concat {
                        regex_postfix.push(RegexBuildingBlock::Concatenation);
                        concat = false;
                    }
                }

            }

            '?' => { 
                while let Some(block) = stack.pop() {
                    regex_postfix.push(block);
                }

                // remove concatenations
                loop {
                    match regex_postfix.last().unwrap() {
                        RegexBuildingBlock::Concatenation => {
                            regex_postfix.pop();
                            concat = true;
                        }
                        _ => { break; }
                    }
                }
                
                regex_postfix.push(RegexBuildingBlock::Repeat(0, 1));
                if concat {
                    regex_postfix.push(RegexBuildingBlock::Concatenation);
                    concat = false;
                }
            }

            '(' => {
                if stack.len() == 0 {
                    stack.push(RegexBuildingBlock::OpeningBraces);
                } else {

                    // move to reverter as long as lower or equal precedence!
                    let mut reverter: Vec<RegexBuildingBlock> = vec![];
                    while let Some(block) = stack.pop() {
                        match block {
                            RegexBuildingBlock::OpeningBraces => {
                                stack.push(RegexBuildingBlock::OpeningBraces);
                                break;
                            }
                            RegexBuildingBlock::Or => {
                                stack.push(RegexBuildingBlock::Or);
                                break;
                            }
                            _ => {
                                reverter.push(block);
                            }
                        }
                    }
                    println!("{:?}", reverter);
                    while let Some(block) = reverter.pop() {
                        match block {
                            RegexBuildingBlock::OpeningBraces => {
                                
                            }
                            _ => {
                                regex_postfix.push(block);
                            }
                        }
                    }
                    println!("{:?}", regex_postfix);
                    stack.push(RegexBuildingBlock::OpeningBraces);
                }
            }
            ')' => {

                //concat = regex_postfix.len() > 0;

                let mut reverter: Vec<RegexBuildingBlock> = vec![];
                while let Some(block) = stack.pop() {
                    match block {
                        RegexBuildingBlock::OpeningBraces => {
                            removed_empty_brackets = true;
                            break;
                        }
                        _ => {
                            reverter.push(block);
                        }
                    }
                }

                while let Some(block) = reverter.pop() {
                    match block {
                        _ => {
                            //regex_postfix.push(block);
                            stack.push(block);
                        }
                    }
                }

                if concat {
                    //regex_postfix.push(RegexBuildingBlock::Concatenation);
                    stack.push(RegexBuildingBlock::Concatenation);
                    concat = false;
                }
            }
            '{' => { 
                if character_class_mode || repeat_mode {
                    panic!("Illegal Syntax! Nested brackets!");
                }
                repeat_mode = true;

                // move from stack to postfix
                while let Some(block) = stack.pop() {
                    regex_postfix.push(block);
                }
            }
            '}' => { 
                if !repeat_mode {
                    panic!("Illegal Syntax! '}}' used without opening brackets!");
                }
                repeat_mode = false;
                if character_end_option == None {
                    if regex_postfix.len() > 0 { concat = true; }

                    // remove concatenations
                    loop {
                        match regex_postfix.last().unwrap() {
                            RegexBuildingBlock::Concatenation => {
                                regex_postfix.pop();
                                concat = true;
                            }
                            _ => { break; }
                        }
                    }

                    regex_postfix.push(RegexBuildingBlock::Repeat(
                        (character_start_option.unwrap() as u8 - 0x30) as u8, 
                        (character_start_option.unwrap() as u8 - 0x30) as u8
                    ));
                    if concat {
                        regex_postfix.push(RegexBuildingBlock::Concatenation);
                        concat = false;
                    }
                    character_start_option = None;
                } else {
                    if regex_postfix.len() > 0 { concat = true; }

                    // remove concatenations
                    loop {
                        match regex_postfix.last().unwrap() {
                            RegexBuildingBlock::Concatenation => {
                                regex_postfix.pop();
                                concat = true;
                            }
                            _ => { break; }
                        }
                    }

                    regex_postfix.push(RegexBuildingBlock::Repeat(
                        (character_start_option.unwrap() as u8 - 0x30) as u8, 
                        (character_end_option.unwrap() as u8 - 0x30) as u8
                    ));
                    if concat {
                        regex_postfix.push(RegexBuildingBlock::Concatenation);
                        concat = false;
                    }
                    character_start_option = None;
                    character_end_option = None;
                }
            }

            '[' => { 
                if character_class_mode || repeat_mode {
                    panic!("Illegal Syntax! Nested brackets!");
                }
                character_class_mode = true;

                // move from stack to postfix
                if regex_postfix.len() > 0 { concat = true; }
                while let Some(block) = stack.pop() {
                    regex_postfix.push(block);
                    if concat {
                        regex_postfix.push(RegexBuildingBlock::Concatenation);
                        concat = false;
                    }
                }
             }
            ']' => { 
                if !character_class_mode {
                    panic!("Illegal Syntax! ']' used without opening brackets!");
                }

                if stack.len() > 0 {
                    stack.push(RegexBuildingBlock::CharacterClass(character_start_option.unwrap(), character_end_option.unwrap()));
                } else {
                    if regex_postfix.len() > 0 { concat = true; }
                    regex_postfix.push(RegexBuildingBlock::CharacterClass(character_start_option.unwrap(), character_end_option.unwrap()));
                    if concat {
                        regex_postfix.push(RegexBuildingBlock::Concatenation);
                        concat = false;
                    }
                }

                character_start_option = None;
                character_end_option = None;

                character_class_mode = false;
            }
            '-' => { 
                if !character_class_mode {
                    panic!("Illegal Syntax! Range operator '-' used outside brackets!");
                }
            }

            '|' => {

                loop {
                    if stack.len() == 0 {
                        break;
                    }
                    match stack.last().unwrap() {
                        RegexBuildingBlock::Concatenation => { let x = stack.pop().unwrap(); regex_postfix.push(x); }
                        RegexBuildingBlock::CharacterLiteral(_) => { let x = stack.pop().unwrap(); regex_postfix.push(x); }
                        RegexBuildingBlock::Or => { let x = stack.pop().unwrap(); regex_postfix.push(x); }
                        _ => {break;}
                    }
                }

                stack.push(RegexBuildingBlock::Or);
            }

            '!' => { panic!(); }

            // # not allowed in regex format
            '#' => { panic!(); }

            _ => {
                last_push_was_character_literal = false;
                // if in bracket_mode build up the character class operator with start and end node
                if character_class_mode { // e.g. [a-z]
                    if !c.is_alphanumeric() {
                        panic!("Range border in repeat operator is not a numeric character!");
                    }
                    if character_start_option.is_none() {
                        character_start_option = Some(c);
                    } else {
                        character_end_option = Some(c);
                    }
                } else if repeat_mode { // e.g {3}, {2,4}
                    if !c.is_numeric() && c != ',' {
                        panic!("Range border in repeat operator is not a numeric character!");
                    }
                    if character_start_option.is_none() {
                        character_start_option = Some(c);
                        character_end_option = Some(c);
                    } else {
                        character_end_option = Some(c);
                    }
                } else {
                    if stack.len() > 0 {
                        match stack.last().unwrap() {
                            RegexBuildingBlock::CharacterLiteral(_) => { concat = true}
                            _ => {}
                        }
                        stack.push(RegexBuildingBlock::CharacterLiteral(c));
                        if concat {
                            stack.push(RegexBuildingBlock::Concatenation);
                            concat = false;
                        }
                        last_push_was_character_literal = true;
                    } else {
                        if regex_postfix.len() > 0 { concat = true; }
                        regex_postfix.push(RegexBuildingBlock::CharacterLiteral(c));
                        if concat {
                            regex_postfix.push(RegexBuildingBlock::Concatenation);
                            concat = false;
                        }
                        last_push_was_character_literal = true;
                    }
                }
            }
        }
    }

    //
    // end of input (EOI) detected
    //

    println!("End of Input (EOI) detected");
    println!("Stack:   {:?}", stack);
    println!("Postfix: {:?}", regex_postfix);

    let mut removed_empty_brackets: bool = false;
    while stack.len() > 0 {
        match stack.last().unwrap() {
            RegexBuildingBlock::CloseingBraces => {
                stack.pop();
                removed_empty_brackets = true;
            }
            RegexBuildingBlock::OpeningBraces => {
                stack.pop();
                break;
            }
            _ => { break; }
        }
    }

    if stack.len() > 0 {

        let mut reverter: Vec<RegexBuildingBlock> = vec![];

        // move from stack to postfix
        if regex_postfix.len() > 0 { concat = true; }
        while let Some(block) = stack.pop() {

            match block {

                // the or operator erases # because of the testcase a|b
                RegexBuildingBlock::Or => {

                    while let Some(block) = reverter.pop() {
                        regex_postfix.push(block);
                    }

                    regex_postfix.push(block);
                }

                _ => { reverter.push(block); }
            }
        }

        while let Some(block) = reverter.pop() {
            regex_postfix.push(block);
            if concat {
                regex_postfix.push(RegexBuildingBlock::Concatenation);
                concat = false;
            }
        }

    }

    println!("Postfix: {:?}", regex_postfix);
}

