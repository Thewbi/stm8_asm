    let mut enfa = Enfa::<i32, i32>::new(0);
    let q0 = enfa.initial_index();

    // hello
    let q1 = enfa.states_insert(1);
    let q2 = enfa.states_insert(2);
    let q3 = enfa.states_insert(3);
    let q4 = enfa.states_insert(4);
    let q5 = enfa.states_insert(5);
    let q6 = enfa.states_insert(6);
    enfa.set_final(q6);

    // world
    let q7 = enfa.states_insert(7);
    let q8 = enfa.states_insert(8);
    let q9 = enfa.states_insert(9);
    let q10 = enfa.states_insert(10);
    let q11 = enfa.states_insert(11);
    let q12 = enfa.states_insert(12);
    enfa.set_final(q12);

    // hello
    enfa.transitions_insert((q0, Segment::empty(), q1));
    enfa.transitions_insert((q1, Segment::singleton(h), q2));
    enfa.transitions_insert((q2, Segment::singleton(e), q3));
    enfa.transitions_insert((q3, Segment::singleton(l), q4));
    enfa.transitions_insert((q4, Segment::singleton(l), q5));
    enfa.transitions_insert((q5, Segment::singleton(o), q6));

    // world
    enfa.transitions_insert((q0, Segment::empty(), q7));
    enfa.transitions_insert((q7, Segment::singleton(w), q8));
    enfa.transitions_insert((q8, Segment::singleton(o), q9));
    enfa.transitions_insert((q9, Segment::singleton(r), q10));
    enfa.transitions_insert((q10, Segment::singleton(l), q11));
    enfa.transitions_insert((q11, Segment::singleton(d), q12));

    enfa_to_dot_directed_graph(&enfa, "enfa_automaton.dot");
    let dfa_from_nfa = Dfa::from(&enfa);
    dfa_to_dot_directed_graph(&dfa_from_nfa, "dfa_automaton.dot");
}

