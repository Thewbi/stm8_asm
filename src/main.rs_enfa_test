macro_rules! map {
    ($($x:expr => $y:expr),*) => {{
        #[allow(unused_mut)]
        let mut temp_map = std::collections::BTreeMap::new();
        $(temp_map.insert($x, $y);)*
        temp_map
    }}
}

macro_rules! set {
    ($($x:expr),*) => {{
        #[allow(unused_mut)]
        let mut temp_set = std::collections::BTreeSet::new();
        $(temp_set.insert($x);)*
        temp_set
    }}
}

pub fn enfa_to_dot_directed_graph(enfa: &Enfa<i32, i32>, filename: &str) {

    // 1. Create or overwrite the file
    let file = File::create(filename).expect("Create file failed!");
    
    // 2. Wrap the file in a BufWriter
    let mut writer = BufWriter::new(file);

    // digraph = directed graph
    write!(writer, "{}", "digraph {\n");

    // start pointer
    write!(writer, "\tstart_pointer [label= \"\", shape=none,height=.0,width=.0]\n");

    let initial_state_index_as_string = format!("{:?}", enfa.initial_index());
    write!(writer, "\tstart_pointer -> {};\n", &initial_state_index_as_string[20..initial_state_index_as_string.len()-2]);

    for final_state_index in enfa.final_indices() {

        let final_state_index_as_string = format!("{:?}", final_state_index);
        write!(writer, "\t{}[shape=doublecircle];\n", &final_state_index_as_string[20..final_state_index_as_string.len()-2]);
    }

    // iterate over indices
    for state_index in enfa.state_indices() {

        // get the state at the state index
        //let state = enfa.states_index(state_index);
        //println!("{:?}", state);

        // // get all transitions of state
        // for transition_index in enfa.transition_indices_from(state_index) {
        //     println!("{:?}", transition_index);
        // }

        for transition in enfa.transitions_slice(enfa.transition_indices_from(state_index)) {

            //println!("{:?} -> [{:?}] -> {:?}", state_index, transition, transition);
            //println!("{:?}", transition);

            let start_state_index = transition.0;
            let transition_val = transition.1.lower();
            let end_state_index = transition.2;

            let empty_transition = (transition.1.lower() == transition.1.upper()) && *transition.1.lower() == 0;

            //println!("{:?} -> {:?}", start_state_index, end_state_index);
            //println!("{} -> {}", start_state_index as i32, end_state_index as i32);
            //println!("{} -> {}", start_state_index.inner, end_state_index.inner);

            //writeln!(writer, start_state_index

            let start_index_as_string = format!("{:?}", start_state_index);
            let end_index_as_string = format!("{:?}", end_state_index);
            //println!("{:?}", &start_index_as_string[20..start_index_as_string.len()-2]);
            //println!("{:?}", &end_index_as_string[20..end_index_as_string.len()-2]);
            write!(writer, "\t{}", &start_index_as_string[20..start_index_as_string.len()-2]);
            write!(writer, " -> ");
            write!(writer, "{}", &end_index_as_string[20..end_index_as_string.len()-2]);
            if !empty_transition {
                write!(writer, "[label=\"{:?}\"]", *transition_val as u8 as char);
            }
            write!(writer, ";");
            write!(writer, "\n");
        }
    }

    write!(writer, "{}", "}");

    // 4. Explicitly flush the remaining data to disk
    writer.flush().expect("flush failed!");
}

pub fn dfa_to_dot_directed_graph(dfa: &Dfa<Set<i32>, i32>, filename: &str) {

    // 1. Create or overwrite the file
    let file = File::create(filename).expect("Create file failed!");
    
    // 2. Wrap the file in a BufWriter
    let mut writer = BufWriter::new(file);

    // digraph = directed graph
    write!(writer, "{}", "digraph {\n");

    // start pointer
    write!(writer, "\tstart_pointer [label= \"\", shape=none,height=.0,width=.0]\n");

    let initial_state_index_as_string = format!("{:?}", dfa.initial_index());
    write!(writer, "\tstart_pointer -> {};\n", &initial_state_index_as_string[20..initial_state_index_as_string.len()-2]);

    for final_state_index in dfa.final_indices() {

        let final_state_index_as_string = format!("{:?}", final_state_index);
        write!(writer, "\t{}[shape=doublecircle];\n", &final_state_index_as_string[20..final_state_index_as_string.len()-2]);
    }

    // iterate over indices
    for state_index in dfa.state_indices() {

        for transition in dfa.transitions_slice(dfa.transition_indices_from(state_index)) {

            let start_state_index = transition.0;
            let transition_val = transition.1.lower();
            let end_state_index = transition.2;

            let empty_transition = (transition.1.lower() == transition.1.upper()) && *transition.1.lower() == 0;

            let start_index_as_string = format!("{:?}", start_state_index);
            let end_index_as_string = format!("{:?}", end_state_index);
            //println!("{:?}", &start_index_as_string[20..start_index_as_string.len()-2]);
            //println!("{:?}", &end_index_as_string[20..end_index_as_string.len()-2]);
            write!(writer, "\t{}", &start_index_as_string[20..start_index_as_string.len()-2]);
            write!(writer, " -> ");
            write!(writer, "{}", &end_index_as_string[20..end_index_as_string.len()-2]);
            if !empty_transition {
                write!(writer, "[label=\"{:?}\"]", *transition_val as u8 as char);
            }
            write!(writer, ";");
            write!(writer, "\n");
        }
    }

    write!(writer, "{}", "}");

    // 4. Explicitly flush the remaining data to disk
    writer.flush().expect("flush failed!");
}

