//pub fn load_symbol_from_map_file(symbol: &'static str, filepath: &'static str) -> u32 {
pub fn load_symbol_from_map_file(symbol: &str, filepath: &str) -> u32 {

    // let debug: bool = true;
    let debug: bool = false;

    if let Ok(lines) = read_lines(filepath) {

        // consumes the iterator, returns an (Optional) String
        for line in lines.map_while(Result::ok) {

            // if debug {
            //     println!("{}", line);
            // }

            if line.starts_with(symbol) {

                if debug {
                    println!("Symbol found: {}", line);
                }

                let mut split = line.split_whitespace();

                // if debug {
                //     println!("Symbol found: {:?}", split);

                //     for part in split {
                //         println!("{}", part)
                //     }
                // }

                let mut _address_as_string = split.next().unwrap();
                _address_as_string = split.next().unwrap();

                if debug {
                    println!("{:?}", _address_as_string);
                }

                let result = u32::from_str_radix(_address_as_string, 16);
                match result {
                    Ok(address) => {
                        // let address = result.unwrap();
                        if debug {
                            println!("0x{:08x}", address);
                        }
                        return address;
                    }
                    Err(_error) => {
                        continue;
                    }
                }

                //let address = u32::from_str_radix(address_as_string, 16).expect("expected a hex numeric!");
                //return address;
            }
        }
    }

    0x00
}



