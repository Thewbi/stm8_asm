Program("build/preprocessed.c")
  



Function("main")

    ; Function Preamble - save space on stack for all local variables - [AsmAstConversionVisitor::visit_tacky_function()]    ; + Updated in AsmAstFixupVisitor::visit_asm_ast_function()

    AllocateStack(16)
    Mov(Doubleword, src:AsmAstOperand { operand_type: Imm(1) }, dst:AsmAstOperand { operand_type: Memory(RBP, -4) }, offset:AsmAstOperand { operand_type: Unknown })
    Mov(Doubleword, src:AsmAstOperand { operand_type: Imm(0) }, dst:AsmAstOperand { operand_type: Memory(RBP, -8) }, offset:AsmAstOperand { operand_type: Unknown })

    ; binary_relational (2)
    Cmp(unary_operator:Not,
            assembly_type:Doubleword,
            dst:AsmAstOperand { operand_type: Imm(1) },
            src_2:AsmAstOperand { operand_type: Memory(RBP, -4) })

    ; binary_relational (3) - initialize temporary with zero
    Mov(Doubleword, src:AsmAstOperand { operand_type: Imm(0) }, dst:AsmAstOperand { operand_type: Memory(RBP, -12) }, offset:AsmAstOperand { operand_type: Unknown })

    ; binary_relational (4) - Set result of comparision into temp variable (temp var see (3))
    SetCC(dst:AsmAstOperand { operand_type: Memory(RBP, -12) }, src:AsmAstOperand { operand_type: ComparisonType("E") })

    ; JumpIfZero
    Cmp(unary_operator:Not,
            assembly_type:Doubleword,
            dst:AsmAstOperand { operand_type: Imm(0) },
            src_2:AsmAstOperand { operand_type: Memory(RBP, -12) })
    JmpCC(dst:AsmAstOperand { operand_type: Label("switch_case_36_end_label_0") }, src:AsmAstOperand { operand_type: ComparisonType("E") })
    Binary(binary_operator:Add, assembly_type:Doubleword, src_2:AsmAstOperand { operand_type: Imm(1) }, dst:AsmAstOperand { operand_type: Memory(RBP, -8) })    Jmp(dst:AsmAstOperand { operand_type: Label("switch_final_58_end_label") }, src:AsmAstOperand { operand_type: Unknown })
    Label(value:AsmAstOperand { operand_type: Label("switch_case_36_end_label_0") })
    Label(value:AsmAstOperand { operand_type: Label("switch_final_58_end_label") })

    ; Generated by the Return keyword in TackyToIntermediateAsmConversionVisitor
    Mov(Doubleword, src:AsmAstOperand { operand_type: Memory(RBP, -8) }, dst:AsmAstOperand { operand_type: Reg(EAX) }, offset:AsmAstOperand { operand_type: Unknown })
    Ret
