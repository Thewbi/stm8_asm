Program("build/preprocessed.c")
  



Function("main")

    ; Function Preamble - save space on stack for all local variables - [AsmAstConversionVisitor::visit_tacky_function()]    ; + Updated in AsmAstFixupVisitor::visit_asm_ast_function()

    AllocateStack(16)
    Mov(Doubleword, src:AsmAstOperand { operand_type: Imm(1) }, dst:AsmAstOperand { operand_type: Memory(RBP, -4) }, offset:AsmAstOperand { operand_type: Unknown })
    Mov(Doubleword, src:AsmAstOperand { operand_type: Imm(0) }, dst:AsmAstOperand { operand_type: Memory(RBP, -8) }, offset:AsmAstOperand { operand_type: Unknown })
    Binary(binary_operator:Add, assembly_type:Doubleword, src_2:AsmAstOperand { operand_type: Imm(1) }, dst:AsmAstOperand { operand_type: Memory(RBP, -8) })    Binary(binary_operator:Add, assembly_type:Doubleword, src_2:AsmAstOperand { operand_type: Imm(2) }, dst:AsmAstOperand { operand_type: Memory(RBP, -8) })    Label(value:AsmAstOperand { operand_type: Label("switch_final_52_end_label") })

    ; Generated by the Return keyword in TackyToIntermediateAsmConversionVisitor
    Mov(Doubleword, src:AsmAstOperand { operand_type: Memory(RBP, -8) }, dst:AsmAstOperand { operand_type: Reg(EAX) }, offset:AsmAstOperand { operand_type: Unknown })
    Ret
