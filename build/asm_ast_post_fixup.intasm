Program("build/preprocessed.c")
  



Function("main")

    ; Function Preamble - save space on stack for all local variables - [AsmAstConversionVisitor::visit_tacky_function()]    ; + Updated in AsmAstFixupVisitor::visit_asm_ast_function()

    AllocateStack(16)
    Mov(Doubleword, src:AsmAstOperand { operand_type: Imm(0) }, dst:AsmAstOperand { operand_type: Memory(RBP, -4) }, offset:AsmAstOperand { operand_type: Unknown })
    Mov(Doubleword, src:AsmAstOperand { operand_type: Imm(0) }, dst:AsmAstOperand { operand_type: Memory(RBP, -8) }, offset:AsmAstOperand { operand_type: Unknown })
    Label(value:AsmAstOperand { operand_type: Label("while_53_continue_label") })

 ; Added by FixupVistor - clone 1
    Mov(Doubleword, src:AsmAstOperand { operand_type: Memory(RBP, -4) }, dst:AsmAstOperand { operand_type: Reg(R10) }, offset:AsmAstOperand { operand_type: Unknown })
    Mov(Doubleword, src:AsmAstOperand { operand_type: Reg(R10) }, dst:AsmAstOperand { operand_type: Memory(RBP, -12) }, offset:AsmAstOperand { operand_type: Unknown })

 ; FIXUP Visitor
    Mov(Doubleword, src:AsmAstOperand { operand_type: Memory(RBP, -4) }, dst:AsmAstOperand { operand_type: Reg(R10) }, offset:AsmAstOperand { operand_type: Unknown })
    Unary(unary_operator:Not, assembly_type:Doubleword, dst:AsmAstOperand { operand_type: Memory(RBP, -12) }, src:AsmAstOperand { operand_type: Reg(R10) })

    ; JumpIfZero
    Cmp(unary_operator:Not,
            assembly_type:Doubleword,
            dst:AsmAstOperand { operand_type: Imm(0) },
            src_2:AsmAstOperand { operand_type: Memory(RBP, -12) })
    JmpCC(dst:AsmAstOperand { operand_type: Label("while_53_end_label") }, src:AsmAstOperand { operand_type: ComparisonType("E") })

    ; binary_relational (2)
    Cmp(unary_operator:Not,
            assembly_type:Doubleword,
            dst:AsmAstOperand { operand_type: Imm(10) },
            src_2:AsmAstOperand { operand_type: Memory(RBP, -8) })

    ; binary_relational (3) - initialize temporary with zero
    Mov(Doubleword, src:AsmAstOperand { operand_type: Imm(0) }, dst:AsmAstOperand { operand_type: Memory(RBP, -16) }, offset:AsmAstOperand { operand_type: Unknown })

    ; binary_relational (4) - Set result of comparision into temp variable (temp var see (3))
    SetCC(dst:AsmAstOperand { operand_type: Memory(RBP, -16) }, src:AsmAstOperand { operand_type: ComparisonType("E") })

    ; JumpIfZero
    Cmp(unary_operator:Not,
            assembly_type:Doubleword,
            dst:AsmAstOperand { operand_type: Imm(0) },
            src_2:AsmAstOperand { operand_type: Memory(RBP, -16) })
    JmpCC(dst:AsmAstOperand { operand_type: Label("if_43_end_label") }, src:AsmAstOperand { operand_type: ComparisonType("E") })
    Mov(Doubleword, src:AsmAstOperand { operand_type: Imm(1) }, dst:AsmAstOperand { operand_type: Memory(RBP, -4) }, offset:AsmAstOperand { operand_type: Unknown })
    Label(value:AsmAstOperand { operand_type: Label("if_43_end_label") })

 ; Added by FixupVistor - clone 1
    Mov(Doubleword, src:AsmAstOperand { operand_type: Memory(RBP, -8) }, dst:AsmAstOperand { operand_type: Reg(R10) }, offset:AsmAstOperand { operand_type: Unknown })
    Mov(Doubleword, src:AsmAstOperand { operand_type: Reg(R10) }, dst:AsmAstOperand { operand_type: Memory(RBP, -8) }, offset:AsmAstOperand { operand_type: Unknown })

 ; FIXUP Visitor
    Mov(Doubleword, src:AsmAstOperand { operand_type: Memory(RBP, -8) }, dst:AsmAstOperand { operand_type: Reg(R10) }, offset:AsmAstOperand { operand_type: Unknown })
    Unary(unary_operator:Increment, assembly_type:Doubleword, dst:AsmAstOperand { operand_type: Memory(RBP, -8) }, src:AsmAstOperand { operand_type: Reg(R10) })
    Jmp(dst:AsmAstOperand { operand_type: Label("while_53_continue_label") }, src:AsmAstOperand { operand_type: Unknown })
    Label(value:AsmAstOperand { operand_type: Label("while_53_end_label") })

    ; Generated by the Return keyword in TackyToIntermediateAsmConversionVisitor
    Mov(Doubleword, src:AsmAstOperand { operand_type: Memory(RBP, -8) }, dst:AsmAstOperand { operand_type: Reg(EAX) }, offset:AsmAstOperand { operand_type: Unknown })
    Ret
