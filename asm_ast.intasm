Program("res/C/samples/nora_sandler/binary_11.c")
  Function("main")

    ; Function Preamble - save space on stack for all local variables - [AsmAstConversionVisitor::visit_tacky_function()]
    AllocateStack(0)
    Mov(src:AsmAstOperand { operand_type: Imm(1) }, dst:AsmAstOperand { operand_type: Pseudo("a") })
    Mov(src:AsmAstOperand { operand_type: Imm(2) }, dst:AsmAstOperand { operand_type: Pseudo("b") })
    Mov(src:AsmAstOperand { operand_type: Pseudo("b") }, dst:AsmAstOperand { operand_type: Pseudo("c") })
    Binary(ADD,
        src_2:AsmAstOperand { operand_type: Pseudo("Fixme!") },
        dst:AsmAstOperand { operand_type: Pseudo("c") })

    ; Generated by the Return keyword in asm_ast_conversion_visitor
    Mov(src:AsmAstOperand { operand_type: Imm(0) }, dst:AsmAstOperand { operand_type: Reg(AX) })
    Ret
