Program("res/C/samples/nora_sandler/pointers_5.c")
  Function("main")

    ; Function Preamble - save space on stack for all local variables - [AsmAstConversionVisitor::visit_tacky_function()]
    AllocateStack(0)
    Mov(src:AsmAstOperand { operand_type: Imm(1) }, dst:AsmAstOperand { operand_type: Pseudo("userdef_var.0") })

    ; lea for GetAddress()
    Lea(src:AsmAstOperand { operand_type: Pseudo("userdef_var.0") }, dst:AsmAstOperand { operand_type: Reg(BX) })
    Mov(src:AsmAstOperand { operand_type: Reg(BX) }, dst:AsmAstOperand { operand_type: Pseudo("userdef_var.1") })

    ; TACKY Store() - 1
    Mov(src:AsmAstOperand { operand_type: Pseudo("userdef_var.1") }, dst:AsmAstOperand { operand_type: Reg(AX) })
    Mov(src:AsmAstOperand { operand_type: Imm(122) }, dst:AsmAstOperand { operand_type: Memory(AX, 0) })

    ; Generated by the Return keyword in asm_ast_conversion_visitor
    Mov(src:AsmAstOperand { operand_type: Pseudo("userdef_var.0") }, dst:AsmAstOperand { operand_type: Reg(AX) })
    Ret
