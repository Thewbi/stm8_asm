Program("res/C/samples/nora_sandler/binary_logical_1.c")
  Function("main")

    ; Function Preamble - save space on stack for all local variables - [AsmAstConversionVisitor::visit_tacky_function()]
    AllocateStack(0)
    Mov(src:AsmAstOperand { operand_type: Imm(1) }, dst:AsmAstOperand { operand_type: Pseudo("userdef_var.0") })
    Binary(LOGICAL_OR,
        src_2:AsmAstOperand { operand_type: Imm(0) },
        dst:AsmAstOperand { operand_type: Pseudo("userdef_var.0") })

    ; Generated by the Return keyword in asm_ast_conversion_visitor
    Mov(src:AsmAstOperand { operand_type: Imm(0) }, dst:AsmAstOperand { operand_type: Reg(AX) })
    Ret
